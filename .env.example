# --- Mailbox (Gmail: enable 2-step verification, then create an "App password") ---
EMAIL_USER=your_campus_email@gmail.com
EMAIL_PASS=your_gmail_app_password
IMAP_SERVER=imap.gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
# Optional: send through Resend instead of SMTP
RESEND_API_KEY=
RESEND_FROM=MailSync AI <onboarding@resend.dev>

# --- LLM for extraction ---
LLM_PROVIDER=groq            # groq or openai
LLM_API_KEY=gsk_your_groq_or_openai_key
LLM_MODEL=                   # optional, defaults: llama-3.3-70b-versatile / gpt-4o-mini

# --- Embeddings (Groq cannot do embeddings, so use OpenAI or local) ---
EMBEDDING_PROVIDER=openai    # openai (1536 dims) or local (384 dims, needs sentence-transformers)
OPENAI_API_KEY=sk-your_openai_key

# --- Supabase (use the service_role key; keep it secret) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key

# --- Behaviour ---
MATCH_THRESHOLD=0.78
POLL_INTERVAL=20
DRY_RUN_EMAIL=true           # true = log emails instead of sending (recommended while testing)
WEBHOOK_SECRET=              # optional: require header X-Webhook-Secret on /webhook/email
